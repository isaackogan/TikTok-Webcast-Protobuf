{
  "name": "tiktok-live-proto-full-types",
  "version": "0.1.1",
  "description": "Types-only TypeScript declarations for the full TikTok Webcast Protobuf schema (no wire codec, no field numbers).",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isaackogan/TikTok-Webcast-Protobuf.git",
    "directory": "targets/typescript/tiktok-live-proto-full-types"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./v1": {
      "types": "./dist/v1.d.ts",
      "default": "./dist/v1.js"
    },
    "./v2": {
      "types": "./dist/v2.d.ts",
      "default": "./dist/v2.js"
    },
    "./v3": {
      "types": "./dist/v3.d.ts",
      "default": "./dist/v3.js"
    }
  },
  "scripts": {
    "generate": "tsx scripts/generate.mts && tsx scripts/shuffle.mts && npm run typecheck",
    "shuffle": "tsx scripts/shuffle.mts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && tsdown",
    "clean": "rm -rf dist tmp",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@babel/generator": "^7.25.0",
    "@babel/parser": "^7.25.0",
    "@babel/types": "^7.25.0",
    "@types/babel__generator": "^7.6.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "js-yaml": "^4.1.0",
    "ts-proto": "^2.11.6",
    "tsdown": "^0.21.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
